# ==============================================================================
# ⚔️ YBA Discord Ranked Bot - Production Environment Variables
# ==============================================================================

# Токен бота из Discord Developer Portal (ОБЯЗАТЕЛЬНО)
DISCORD_TOKEN=your_bot_token_here

# ID одного или нескольких серверов (через запятую) для мгновенной регистрации слэш-команд
# Например: GUILD_IDS=1562131176678760478,1371129578449539144
# Если пусто - слэш-команды регистрируются глобально (может занять до 1 часа по Discord API)
GUILD_ID=
GUILD_IDS=

# Роль Респонсиблов / Судей (имеют право вносить результаты /match report)
RESP_ROLE_NAME=⋆ 1v1s Responsible
RESP_ROLE_ID=1371133559531634851

# Роль Главных Администраторов (сброс сезонов, корректировка ELO, бэкапы)
ADMIN_ROLE_NAME=Администратор
ADMIN_ROLE_ID=

# Роли для регламента вызовов на дуэль GangHub League (опционально)
DUCK_ROLE_NAME=Duck
DUCK_ROLE_ID=1372618658253111326

DUCK_EVADE_ROLE_NAME=Duck Evade
DUCK_EVADE_ROLE_ID=1562573962972627056

# Канал для автоматических логов Duck
DUCK_CHANNEL_NAME=ducks
DUCK_CHANNEL_ID=1534056814117916702

# Канал и форум для создания дуэлей (elo-1v1)
FIGHTS_INFO_CHANNEL_ID=1562574681637257387

# Канал для публичных результатов матчей (1v1s-elos)
MATCH_RESULTS_CHANNEL_ID=1562552971961565247
MATCH_RESULTS_CHANNEL_NAME=1v1s-elos

# ID канала очереди поиска матчей (если нужно ограничить команду /queue)
QUEUE_CHANNEL_ID=

# Опционально: API ключ Bloxlink для автоматической верификации и проверки аккаунтов
# Получить бесплатно: https://blox.link/dashboard/user/developer
BLOXLINK_API_KEY=

# Опционально: привилегированные интенты Discord (требуют включения в Discord Developer Portal -> Bot -> Privileged Gateway Intents)
ENABLE_MEMBERS_INTENT=false
ENABLE_MESSAGE_CONTENT=false

# Настройки базы данных и путей
# ВНИМАНИЕ: Для Docker и Systemd база должна находиться в папке data/ (монтируется в Docker volume)
DB_PATH=data/elo_yba.sqlite
BACKUP_DIR=data/backups
BACKUP_MAX_DAYS=30
BACKUP_MAX_FILES=50

# Настройки логирования (DEBUG, INFO, WARNING, ERROR)
LOG_DIR=logs
LOG_LEVEL=INFO
